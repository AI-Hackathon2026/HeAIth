# Copy to .env.local for local development, and set the same keys in
# Vercel → Project → Settings → Environment Variables.

# Required in production: secret used to sign login tokens (any long random string).
TOKEN_SECRET=

# Required for AI chat and routine generation (Google AI Studio key).
GEMINI_API_KEY=

# Admin account created automatically on first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# Optional: lets POST /api/users/signup/admin create more admins
# when sent in the x-admin-signup-key header.
ADMIN_SIGNUP_KEY=

# Optional: token lifetimes (15m | 1h, and 7d).
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Optional: where db.json and uploaded PDFs are written.
# Defaults to ./data locally and /tmp/heaith on Vercel.
DATA_DIR=

# Optional: Gmail SMTP for account notification emails (logged only when unset).
EMAIL_USER=
EMAIL_PASSWORD=
